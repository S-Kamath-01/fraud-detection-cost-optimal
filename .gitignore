# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
build/
dist/

# --- Virtual environments ---
fraud-det/
venv/
.venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (large, never commit raw/processed data) ---
# Scoped to actual project subpaths, not a bare "data/" match,
# so this won't accidentally swallow something like src/data/ later.
/data/raw/*
/data/processed/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
/data_exploration/*.csv

# --- Model artifacts ---
# xgb_model.json, feature_columns.json, threshold_config.json are
# deployment artifacts (not intermediate training state) and ARE
# committed - see README "Deployment artifacts" note. Everything else
# in checkpoints/ (e.g. threshold_search_results.csv) stays ignored.
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/xgb_model.json
!checkpoints/feature_columns.json
!checkpoints/threshold_config.json
!checkpoints/drift_reference.csv
*.pkl
*.joblib
*.h5

# --- Env / secrets ---
.env
.env.local
*.pem

# --- Docker ---
docker-compose.override.yml

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Logs ---
*.log
